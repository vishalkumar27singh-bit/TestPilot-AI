# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# Keep values at the TOP LEVEL (no [sections]). NEVER commit the real secrets.toml.
ANTHROPIC_API_KEY = "sk-ant-..."
# or:
# OPENAI_API_KEY = "sk-..."
# AI_PROVIDER = "anthropic"     # optional: "anthropic" | "openai"
# AI_MODEL = ""                 # optional model override
# CHROME_BINARY = ""            # optional: only if Chromium is in a non-standard place
# CHROMEDRIVER_PATH = ""        # optional
