# Local use: copy to .env. On Streamlit Community Cloud put the same keys in the app's Secrets instead.
# The app works without any AI key (rule-based fallback).
# Provider: "anthropic" or "openai" (any OpenAI-compatible endpoint). Auto-detected from whichever key is set.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
AI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Browser binaries (normally auto-detected; set only if needed, e.g. custom Chromium path)
CHROME_BINARY=
CHROMEDRIVER_PATH=

# Safety (defaults are the safe values)
ALLOW_LOOPBACK_TARGETS=false      # true = allow 127.0.0.1/localhost (needed for the bundled sample site)
ALLOW_PRIVATE_NETWORKS=false      # true = allow 10.x/192.168.x/172.16.x etc. NOT recommended

# Test engine defaults
HEADLESS_BROWSER=true
REQUEST_TIMEOUT=10
PAGE_LOAD_TIMEOUT=30
MAX_LINKS_TO_CHECK=25
RENDER_WAIT_SECONDS=8            # max seconds to wait for JavaScript-rendered pages (Streamlit, React...)
